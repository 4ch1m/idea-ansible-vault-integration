<idea-plugin>
    <id>com.github.timo_reymann.ansible_vault_integration</id>

    <name>Ansible Vault Integration</name>

    <vendor
            email="intellij@achimonline.de"
            url="https://www.achimonline.de">
        Achim Seufert
    </vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.yaml</depends>

    <extensions defaultExtensionNs="com.intellij">
        <intentionAction>
            <language/>
            <className>de.achimonline.ansible_vault_integration.intention.UnvaultIntentionAction</className>
            <categoryKey>intention.category</categoryKey>
        </intentionAction>

        <intentionAction>
            <language/>
            <className>de.achimonline.ansible_vault_integration.intention.VaultIntentionAction</className>
            <categoryKey>intention.category</categoryKey>
        </intentionAction>

        <projectConfigurable
                id="de.achimonline.ansible_vault_integration.settings.AnsibleVaultSettingsConfigurable"
                groupId="tools"
                key="settings.display_name"
                instance="de.achimonline.ansible_vault_integration.settings.AnsibleVaultSettingsConfigurable"/>

        <projectService serviceImplementation="de.achimonline.ansible_vault_integration.settings.AnsibleVaultSettings"/>

        <projectService serviceImplementation="de.achimonline.ansible_vault_integration.config.AnsibleConfigurationService"/>
    </extensions>

    <actions>
        <action id="vault_or_unvault_file"
                class="de.achimonline.ansible_vault_integration.intention.menu.VaultFileMenuAction">
            <add-to-group group-id="CutCopyPasteGroup" anchor="last"/>
        </action>
    </actions>

    <resource-bundle>messages.AnsibleVaultIntegrationBundle</resource-bundle>
</idea-plugin>
